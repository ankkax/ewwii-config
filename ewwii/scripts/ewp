#!/bin/bash
# ewp -- ewwii for the pop-up panels and OSD (~/.config/ewwii-panels).
#
# The bar runs in its own daemon so it can appear quickly at login; the panels
# load in a second daemon.  If that daemon is not running yet, it is started
# here (and waited for) before the command is passed on.
CFG="$HOME/.config/ewwii-panels"
EWW=/usr/bin/ewwii

case "${1:-}" in
    daemon|ping|kill) exec "$EWW" -c "$CFG" "$@" ;;
esac

if ! "$EWW" -c "$CFG" ping >/dev/null 2>&1; then
    setsid "$EWW" -c "$CFG" daemon >/dev/null 2>&1 </dev/null &
    for _ in $(seq 1 100); do
        "$EWW" -c "$CFG" ping >/dev/null 2>&1 && break
        sleep 0.1
    done
fi
exec "$EWW" -c "$CFG" "$@"
