Poll "bt"   { interval = "10s" initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh bt" }
Poll "btt"  { interval = "10s" initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh btt" }

Poll "bright"  { interval = "3s" initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh bright" }
Poll "brightt" { interval = "10s" initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh brightt" }
Poll "kbl"     { interval = "30s" initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh kb" }
Poll "kblt"    { interval = "30s" initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh kbt" }

Poll "np"    { interval = "3s" initial = ""      cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/nowplaying.sh chip" }
Poll "npt"   { interval = "3s" initial = ""      cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/nowplaying.sh text" }
Poll "nptip" { interval = "3s" initial = ""      cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/nowplaying.sh tooltip" }
Poll "npv"   { interval = "3s" initial = "false" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/nowplaying.sh visible" }

# Workspace (tag) state + label, pushed by scripts/tags-watch.sh.
Poll "ws0" { interval = "3600s" initial = "vacant" cmd = "echo vacant" }
