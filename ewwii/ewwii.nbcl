# ------------------------------- panels ----------------------------------

# Panel strings that eww's template engine can express but ewwii's cannot
# (hyphenated literals / parenthesised nested ternaries) are resolved by
# scripts/panel-text.sh and bound directly.

# CPU usage glyph (bar) and tooltip
Poll "cpu"  { interval = "5s" initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh cpu" }
Poll "cput" { interval = "5s" initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh cput" }

# keep-awake state and glyph (xset)
Poll "caffeine_state" { interval = "2s" initial = "off" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/caffeine.sh state" }
Poll "caffeine_icon"  { interval = "2s" initial = ""    cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/caffeine.sh icon" }
Poll "gamepad_state" { interval = "2s" initial = "off" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/gamepad.sh state" }
Poll "gamepad_icon"  { interval = "2s" initial = ""    cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/gamepad.sh icon" }
Poll "is_laptop"  { interval = "3600s" initial = "true"  cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh haslaptop" }
Poll "is_desktop" { interval = "3600s" initial = "false" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh hasdesktop" }
Poll "pprof"      { interval = "5s" initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh pprof" }
Poll "pprof_text" { interval = "5s" initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh pproft" }

# active ASUS power profile name (asusctl); the three profiles themselves are
# a fixed set and are hard-coded in the panel below.

# refresh rate remembered for battery (60 | 90 | 144); set by refresh-rate.sh

# bluetooth panel + world clock ---------------------------------------------

# ================================ widgets ================================

# workspaces --------------------------------------------------------------
component Ws (idx) {
    EventBox {
        class = global("ws" + idx).template("ws {ws" + idx + "}")
        timeout = "2s"
        onclick = "xdotool set_desktop " + idx

        Label {
            text = global("ws" + idx + "l")
        }
    }
}

component Workspaces () {
    # Wheel scrolling is handled by ~/.local/bin/ws-wheel (reads X directly).
    EventBox {
        timeout = "2s"

        Box {
            class = "workspaces"
            orientation = "h"
            space_evenly = false

            for i in ["0", "1", "2", "3", "4", "5", "6", "7", "8"] {
                Ws { idx = i }
            }
        }
    }
}

# now playing (cliamp) ----------------------------------------------------
component Nowplaying () {
    EventBox {
        class = "mod nowplaying"
        visible = global("npv")
        tooltip = global("nptip")
        timeout = "3s"
        onclick = "/home/miika/.config/ewwii/scripts/nowplaying.sh toggle"
        onrightclick = "/home/miika/.config/ewwii/scripts/nowplaying.sh next"
        onscroll = "/home/miika/.config/ewwii/scripts/nowplaying.sh scroll {}"

        Box {
            orientation = "h"
            space_evenly = false
            spacing = 8

            Label { class = "np-chip"  text = global("np")  width = 20  xalign = 0.5 }
            Label { class = "np-track" text = global("npt") width = 290 xalign = 0 limit_width = 30 }
        }
    }
}

# centre clock ------------------------------------------------------------
component Clock () {
    EventBox {
        class = "clock"
        tooltip = "Calendar  ·  right-click: toggle date format"
        onclick = "/home/miika/.config/ewwii/scripts/panel.sh toggle cal"
        onrightclick = "/home/miika/.config/ewwii/scripts/clock-cycle.sh"

        Label { class = "clock-text" text = global("clock") }
    }
}

component KeyboardLayout () {
    EventBox {
        class = "mod kbl"
        visible = global("kblstate")
        tooltip = global("kblt")
        timeout = "2s"
        onclick = "/home/miika/.config/ewwii/scripts/kb-cycle.sh"

        Label { text = global("kbl") }
    }
}

component Weather () {
    EventBox {
        class = "weather"
        tooltip = "Weather  ·  click: forecast"
        onclick = "/home/miika/.config/ewwii/scripts/panel.sh toggle weather"
        onrightclick = "notify-send -a ewwii Weather \"$(/home/miika/.config/ewwii/scripts/weather.sh text)\""

        Label { text = global("weather") }
    }
}

component Updates () {
    EventBox {
        class = "mod upd"
        visible = global("updstate")
        tooltip = global("updt")
        onclick = "setsid -f /usr/bin/kitty --class pacman-update -o remember_window_size=no -o initial_window_width=1200 -o initial_window_height=700 -e bash -c 'clear; echo \"=========================================\"; echo \"           SYSTEM UPDATE\"; echo \"           sudo pacman -Syu\"; echo \"=========================================\"; echo; sudo pacman -Syu; echo; echo \"=========================================\"; read -n1 -r -p \"Paina näppäintä sulkeaksesi\"'"

        Label { text = global("upd") width = 21 xalign = 0.5 }
    }
}

# right-hand indicators ---------------------------------------------------
component Bar () {
    OverLay {
        class = "bar"
        hexpand = true

        # left: Arch logo + workspaces + now playing
        Box {
            class = "left"
            orientation = "h"
            space_evenly = false
            halign = "start"

            EventBox {
                class = "logo"
                tooltip = "Menu  ·  right-click: terminal"
                onclick = "setsid -f rofi -show drun -config ~/.config/rofi/config.rasi"
                onrightclick = "setsid -f alacritty"

                Label { class = "logo-glyph" text = "" width = 24 xalign = 0 }
            }

            Workspaces {}

            Nowplaying {}
        }

        # centre: indicators (keep-awake) + clock + weather + updates
        # (order follows Omarchy 4's bar layout, config/omarchy/shell.json)
        Box {
            class = "center"
            orientation = "h"
            space_evenly = false
            halign = "center"

            EventBox {
                class = global("caffeine_state").template("mod caffeine {caffeine_state == 'on' ? 'active' : ''}")
                tooltip = global("caffeine_state").template("Keep awake: {caffeine_state}  ·  click to toggle")
                onclick = "/home/miika/.config/ewwii/scripts/caffeine.sh toggle"
                timeout = "3s"

                Label { text = global("caffeine_icon") width = 17 xalign = 0.5 }
            }

            EventBox {
                class = global("gamepad_state").template("mod gamepad {gamepad_state == 'on' ? 'active' : ''}")
                tooltip = global("gamepad_state").template("Desktop gamepad mode: {gamepad_state}  ·  Home button does not switch to tty2 when on  ·  click to toggle")
                onclick = "/home/miika/.config/ewwii/scripts/gamepad.sh toggle"
                timeout = "3s"

                Label { text = global("gamepad_icon") width = 17 xalign = 0.5 }
            }

            Clock {}
            Weather {}
            Updates {}
        }

        # right: indicators
        Box {
            class = "right"
            orientation = "h"
            space_evenly = false
            spacing = 2
            halign = "end"

            KeyboardLayout {}

            Systray { icon_size = 16 spacing = 6 }

            EventBox {
                class = "mod bt"
                tooltip = global("btt")
                onclick = "/home/miika/.config/ewwii/scripts/panel.sh toggle bt"
                onrightclick = "/home/miika/.config/ewwii/scripts/bt-toggle.sh"
                timeout = "3s"

                Label { text = global("bt") width = 28 xalign = 0.5 }
            }

            EventBox {
                class = "mod"
                tooltip = global("nett")
                timeout = "3s"
                onclick = "/home/miika/.config/ewwii/scripts/panel.sh toggle net"

                Label { text = global("net") width = 28 xalign = 0.5 }
            }

            EventBox {
                class = "mod"
                tooltip = global("volt")
                timeout = "3s"
                onclick = "/home/miika/.config/ewwii/scripts/panel.sh toggle vol"
                onrightclick = "/home/miika/.config/ewwii/scripts/osd.sh vol mute"
                onscroll = "/home/miika/.config/ewwii/scripts/osd.sh scroll vol {}"

                Label { text = global("vol") width = 28 xalign = 0.5 }
            }

            EventBox {
                class = "mod"
                tooltip = global("brightt")
                timeout = "3s"
                onclick = "/home/miika/.config/ewwii/scripts/panel.sh toggle bright"
                onscroll = "/home/miika/.config/ewwii/scripts/osd.sh scroll bright {}"

                Label { text = global("bright") width = 28 xalign = 0.5 }
            }

            EventBox {
                class = "mod"
                tooltip = global("cput")
                timeout = "5s"
                onclick = "setsid -f kitty btop"

                Label { text = global("cpu") width = 28 xalign = 0.5 }
            }

            EventBox {
                class = "mod power"
                tooltip = global("batt")
                visible = global("is_laptop")
                timeout = "3s"
                onclick = "/home/miika/.config/ewwii/scripts/panel.sh toggle power"
                onrightclick = "/home/miika/.config/ewwii/scripts/toggle.sh bat_pct"

                Box {
                    orientation = "h"
                    space_evenly = false

                    Label { text = global("bat") width = 28 xalign = 0.5 }
                    Label { class = "pct" text = global("batp") visible = global("bat_pct") }
                }
            }

            EventBox {
                class = "mod power"
                tooltip = global("pprof_text")
                visible = global("is_desktop")
                timeout = "3s"
                onclick = "/home/miika/.config/ewwii/scripts/panel.sh toggle power"

                Label { text = global("pprof") width = 28 xalign = 0.5 }
            }
        }
    }
}

Window "bar" {
    monitor = 0
    geometry = {
        x = "0%"
        y = "0px"
        width = "100%"
        height = "36px"
        anchor = "top center"
    }
    stacking = "fg"
    windowtype = "dock"
    focusable = "none"
    reserve = { side = "top" distance = "36px" }

    Bar {}
}

