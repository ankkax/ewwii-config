# ===========================================================================
#  ewwii — Omarchy-style bar for OXWM (X11), GTK4 / ewwii port of eww.yuck
#
#  Start :  ewwii daemon  &&  ewwii open bar
#  Reload:  ewwii reload
#  Theme :  ~/.config/ewwii/scripts/set-theme.sh <name|menu>
#
#  Ported from the GTK3 eww config.  Notes on the port:
#    * ewwii's config is evaluated ONCE, so `for x in <poll>` is impossible;
#      the network list is filled at runtime by a Script{...} via
#      find()/set_property() against pre-declared row widgets.
#    * template strings use the GLOBAL NAME as the placeholder, i.e.
#      global("vol_level").template("{vol_level}%") — `{self}` is invalid.
#      Variable names therefore use underscores only (a `-` would be parsed
#      as a subtraction inside a template).
#    * no Systray widget in ewwii, and no CenterBox; the centre is emulated
#      with a 3-way hexpand Box.  The tray module is dropped.
#    * windows are `windowtype="dock"` (not wm_ignore): OXWM is patched to
#      honour _NET_WM_WINDOW_TYPE_DOCK and _NET_WM_STRUT(_PARTIAL), so docks
#      keep their exact geometry, are never tiled/focused, and stay above
#      normal windows.  Only the bar reserves space (top 36px).
# ===========================================================================

import core.json
import core.command

# ------------------------------- data ------------------------------------
Poll "clock"   { interval = "5s"   initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/clock.sh" }
Poll "weather" { interval = "300s" initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/weather.sh" }
# weather panel (native ewwii pop-up): long "icon  condition  temp" line + 3-day rows

Poll "vol"  { interval = "3s"  initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh vol" }
Poll "volt" { interval = "3s"  initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh volt" }
Poll "bat"  { interval = "3s" initial = "" cmd = "/home/miika/.config/ewwii/scripts/poll.sh /home/miika/.config/ewwii/scripts/status.sh bat" }
