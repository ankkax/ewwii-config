# ========================= network list filler ===========================
# Fills the six pre-declared NetRow rows from net-list.sh every few seconds.
# (ewwii cannot loop over a poll signal, so the rows are pre-created and
# updated by name through the widget-control builtins instead.)
Script {
    every = "4s"

    run = |w| {
        let nets = json.parse(command.run_and_read("/home/miika/.config/ewwii/scripts/net-list.sh"))
        let n = len(nets)

        for i in 0..6 {
            let row = "netrow" + to_string(i)

            if i < n {
                let net = nets[i]
                set_property(find(w, row), "visible", "true")
                set_property(find(w, row), "class",
                    if net.connected { "net-row connected" } else { "net-row" })
                set_property(find(w, row), "onclick",
                    "setsid -f /home/miika/.config/ewwii/scripts/net-act.sh connect " + net.esc)

                set_property(find(w, "netglyph" + to_string(i)), "text", net.glyph)
                set_property(find(w, "netssid" + to_string(i)), "text", net.ssid)
                set_property(find(w, "netlock" + to_string(i)), "text", net.lock)
                set_property(find(w, "netsig" + to_string(i)), "text", net.pct)
                set_property(find(w, "netcheck" + to_string(i)), "text", net.check)
            } else {
                set_property(find(w, row), "visible", "false")
            }
        }
    }
}

# ========================= bluetooth list filler =========================
# Same idea as the network filler: fill the six pre-declared BtRow rows from
# bt-list.sh.  A click connects/disconnects depending on the current state.
Script {
    every = "5s"

    run = |w| {
        let devs = json.parse(command.run_and_read("/home/miika/.config/ewwii/scripts/bt-list.sh"))
        let n = len(devs)

        for i in 0..6 {
            let row = "btrow" + to_string(i)

            if i < n {
                let d = devs[i]
                set_property(find(w, row), "visible", "true")
                set_property(find(w, row), "class",
                    if d.connected { "bt-row connected" } else { "bt-row" })
                set_property(find(w, row), "onclick",
                    "setsid -f /home/miika/.config/ewwii/scripts/bt-act.sh " +
                    (if d.connected { "disconnect " } else { "connect " }) + d.esc)

                set_property(find(w, "btglyph" + to_string(i)), "text", d.glyph)
                set_property(find(w, "btname" + to_string(i)), "text", d.name)
                set_property(find(w, "btbatt" + to_string(i)), "text", d.battery)
                set_property(find(w, "btcheck" + to_string(i)), "text", d.check)
            } else {
                set_property(find(w, row), "visible", "false")
            }
        }
    }
}
